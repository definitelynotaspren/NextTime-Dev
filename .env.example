# Nextcloud Time Bank - Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=changeme_strong_password_here

# Where the data lives (see docs/isolated-data.md). Both are external Docker volumes that
# `make docker-data-init` creates once and Compose never deletes. To keep the data of a stack made
# before the database was split out, set them to its existing volumes instead (the names come from
# `docker volume ls`, usually <folder>_db_data and <folder>_nextcloud_data).
# NEXTTIME_DB_VOLUME=nexttime_pgdata
# NEXTTIME_FILES_VOLUME=nexttime_files
# NEXTTIME_DB_HOST=nexttime-db
# The database this Nextcloud instance uses on that server (one database per instance; created once with
# CREATE DATABASE, see docs/isolated-data.md). Unset, it is POSTGRES_DB.
# NEXTTIME_DB_NAME=nexttime35

# Redis Configuration
REDIS_PASSWORD=changeme_redis_password_here

# Nextcloud Configuration
NEXTCLOUD_PORT=8080
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_admin_password_here
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1

# Protocol (http or https)
OVERWRITE_PROTOCOL=http

# PHP Settings
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=512M

# Development Settings (optional)
# XDEBUG_MODE=debug
# XDEBUG_CONFIG=client_host=host.docker.internal
